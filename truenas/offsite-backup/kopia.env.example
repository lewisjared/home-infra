# Copy to /mnt/tank/backups/offsite/kopia.env (root:root, mode 600) and fill in.
# Keep the same values in the password manager: nothing in B2 is readable without them.
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
KOPIA_PASSWORD=
# The S3 endpoint shown on the bucket's details page. EU Central is eu-central-003.
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
