{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", ":semanticCommits"],
  "kubernetes": {
    "managerFilePatterns": [
      "/infrastructure/.+\\.yaml$/",
      "/apps/.+\\.yaml$/",
      "/clusters/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": ["/infrastructure/.+\\.yaml$/", "/apps/.+\\.yaml$/"]
  },
  "flux": {
    "managerFilePatterns": ["/clusters/.+\\.yaml$/"]
  },
  "customManagers": [
    {
      "description": "Keep Talos/Kubernetes versions in sync across the tuppr CRs and tf/variables.tf (bump both in one PR)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^tf/variables\\.tf$/",
        "/^apps/production/core/tuppr/.+\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\S+\\s*[:=]\\s*\"?(?<currentValue>v?[0-9][^\\s\"#]*)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Flux controllers managed by flux CLI (gotk-components.yaml is autogenerated, bump fluxcd/flux2 instead and regenerate)",
      "matchPackageNames": ["/^ghcr\\.io/fluxcd/.*-controller$/"],
      "enabled": false
    },
    {
      "description": "Group Flux updates",
      "groupName": "Flux",
      "matchPackageNames": ["/flux/"]
    },
    {
      "description": "Automerge patch updates for home-operations containers once the release is 24h old",
      "matchPackageNames": ["ghcr.io/home-operations/**"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "1 day",
      "automerge": true
    },
    {
      "description": "LinuxServer.io images use a <version>-ls<build> scheme that default docker versioning cannot order",
      "matchPackageNames": ["ghcr.io/linuxserver/**"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "Group monitoring stack updates",
      "groupName": "Monitoring Stack",
      "matchPackageNames": [
        "/prometheus/",
        "/grafana/",
        "/loki/",
        "/tempo/",
        "/alloy/"
      ]
    }
  ]
}
