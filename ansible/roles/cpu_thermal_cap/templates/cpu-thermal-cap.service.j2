[Unit]
Description=Cap CPU frequency and soften EPP for thermals
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'for c in /sys/devices/system/cpu/cpu*/cpufreq; do echo {{ cpu_thermal_cap_governor }} > $c/scaling_governor; echo {{ cpu_thermal_cap_epp }} > $c/energy_performance_preference; echo {{ cpu_thermal_cap_max_freq_khz }} > $c/scaling_max_freq; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
